# gen 운영 프로필 — **이미지 안의 `datagen.yaml` 위에 덮인다**
#
# `cli.load_cfg` 가 `config/datagen.yaml` 을 읽고 이 파일을 그 위에 겹친다.
# **다른 값만 적는다** — 생성 모수·요율·보관 기간을 여기 복사하면 설정이 두
# 벌이 되고, 한쪽만 고쳐질 때 조용히 어긋난다.
#
# ## 이 파일은 2026-10-20 에 graphio 저장소에서 넘어왔다
#
# 전에는 `graphio-probe-rca/config/datagen-prod.yaml` 이었다. 근거는
# **"운영에 이 저장소의 소스가 없다 — 반출하는 것은 이미지뿐이다"** 였고,
# 그래서 설정을 그쪽 반출 묶음에 실어야 했다.
#
# **그 전제가 무효가 됐다.** 커밋 `f148884`·`cb00eae`(2026-10-16) 이후 현장도
# 두 저장소를 형제로 clone 해 직접 빌드한다 —
# `docker-compose.prod.yml` 의 gen 서비스가 `build.context: ../probe-datagen`
# 이다. 소스가 현장에 있으므로 설정도 자기 저장소에 둔다.
#
# **환경축은 파일 이름 하나다.** 로컬 컨테이너는 `config/local.yaml`, 운영은
# 이 파일(`config/prod.yaml`)이고, 양쪽 모두 컨테이너 안에서 **같은 이름으로**
# 보인다. 전에는 `datagen-prod.yaml` 이 `/app/config/prod.yaml` 로 마운트되어
# 호스트와 컨테이너의 이름이 달랐다 — 컨테이너 안에서 `prod.yaml` 을 열면
# graphio 것인지 gen 것인지 구분할 수 없었다.
#
# 짝이 되는 graphio 쪽 파일은 `../graphio-probe-rca/config/prod.yaml` 이다.

# ── DB 접속 ──────────────────────────────────────────────────────────────
#
# **`127.0.0.1` 을 두면 안 된다.** 컨테이너 안에서 그 주소는 자기 자신이고,
# 실제로 그것 때문에 죽은 적이 있다(`Errno 111 Connection refused`).
#
# **graphio 쪽 `config/prod.yaml` 의 `store.mysql` 과 같은 서버·같은 DB 를
# 가리켜야 한다.** gen 이 쓰고 corr 이 읽는 같은 창고다 — 어긋나면 양쪽이
# 서로 다른 DB 를 보면서 **에러 없이** 빈 화면이 된다.
#
# `pemdb1` 섹션은 host·port·user 를 이 섹션에서 재사용하므로 여기만 고치면
# 상용 스키마 적재 경로도 따라온다.
mysql:
  host: 10.0.0.0              # ← **설치 현장의 MySQL 서버로 바꾼다**
  port: 3306
  user: pem
  # **비워 둔다.** 접속 정보는 `.gp.env` → 환경변수 `GP_MYSQL_PASSWORD` 로
  # 온다(2026-10-20). 저장소에 평문을 두면 git 히스토리에 영구히 남고,
  # 환경마다 **두 저장소 네 자리**를 고쳐야 해서 한 곳을 빠뜨린다.
  password: ""

# ── 원시 Parquet 출력 — **컨테이너 안 경로다** ───────────────────────────
#
# 값이 로컬 컨테이너 프로필과 **같다. 일부러 같게 둔다** — 컨테이너 안에서
# 보는 자리를 한 값으로 고정하면 환경 차이가 compose 의 마운트 좌변에만
# 나타난다(`GP_RAW_ROOT`, 기본 `/DATA1/summary`).
#
# **읽는 쪽과 같은 값이어야 한다** — graphio `config/prod.yaml` 의
# `paths.uplane_raw`·`cplane_raw`. 어긋나면 집계가 조용히 0행이 된다.
pemdb1:
  # ── 행정코드 crosswalk — **컨테이너 안 경로다** ─────────────────────────
  #
  # 기본값은 `../graphio-probe-rca/data/geo/...` 로 호스트 상대경로이고,
  # 컨테이너에서는 `/app` 기준으로 풀려 `/graphio-probe-rca/...` 가 된다 —
  # 그런 경로가 없어서 **기동이 재시작 루프에 빠진다**
  # (`RuntimeError: 행정코드 crosswalk 가 없다`). 로컬에서 실제로 겪었고
  # (2026-10-15) 그때 `container.yaml`(지금의 `local.yaml`)만 고치고
  # **이 파일을 빠뜨렸다.**
  #
  # 파일은 graphio 가 만든다(`python -m graphio geo-xw`). `gp.sh image-save`
  # 의 반출 묶음에 실리고, compose 가 호스트 것을 이 경로로 마운트한다.
  geo_crosswalk: /app/data/geo/code_crosswalk.json

  # ── 생성량 비율(%) ──────────────────────────────────────────────────────
  #
  # **운영은 100% 다.** 기본값(`datagen.yaml` 의 70)은 노트북에서 디스크를
  # 아끼려고 사람이 정한 값이고(2026-10-14) 현장에는 그 사정이 없다. 명시하지
  # 않으면 70% 가 쓰이는데, 그러면 "왜 생성량이 설정의 70% 인가"를 설명할
  # 자리가 없다.
  #
  # **100% 기준(아래 `rates`)을 서버 용량에 맞춰 재는 방법이 있다** —
  # `./gp.sh gen-capacity` 가 배수를 올려가며 생성·쓰기 시간을 재고 60초 틱
  # 예산에 맞는 상한을 알려준다. DB 는 읽기만 한다.
  #
  # UI(:8009)와 DB(`CM_DATAGEN_CONFIG.volume_pct`)가 이 값을 이긴다 —
  # 데몬이 매 분 다시 읽으므로 재기동이 필요 없다.
  rates:
    volume_pct: 100

  uplane_parquet:
    root: /app/data/uplane_raw
  cplane_parquet:
    root: /app/data/cplane_raw
